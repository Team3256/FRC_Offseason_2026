{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "bin/": true,
    "**/*~": true
  },
  "C_Cpp.default.configurationProvider": "vscode-wpilib",
  "C_Cpp.formatting": "clangFormat",
  "editor.formatOnSave": true,
  "wpilib.skipSelectSimulateExtension": false,
  "wpilib.autoStartRioLog": false
}
